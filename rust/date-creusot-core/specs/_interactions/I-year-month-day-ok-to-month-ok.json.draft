{
  "schema_version": "1.0",
  "interaction_id": "I-year-month-day-ok-to-month-ok",
  "caller": {
    "concept": "YearMonthDay",
    "method": "ok"
  },
  "callee": {
    "concept": "Month",
    "method": "ok"
  },
  "edge_class": [
    "numeric-domain-boundary"
  ],
  "eligibility": "boundary-required",
  "rationale": "YearMonthDay::ok delegates the month half of its validity decision to the callee's field-range test, and the caller's own postcondition YearMonthDay.C3 is stated as year().ok() && month().ok() && ..., so a wrong Month::ok admits or rejects whole classes of dates while the day conjunct still looks satisfied.",
  "evidence_links": [
    "E-4",
    "E-12"
  ],
  "reliances": [
    {
      "obligation_id": "YearMonthDayLast.C1",
      "required_assurance": {
        "required_claims": [
          "postcondition-holds"
        ],
        "accepted_evidence_kinds": [
          "creusot-deductive-check"
        ],
        "minimum_scope": {
          "input_domain": "year in [-32767, 32767], month in [1, 12], day in [1, 31], days::rep is a 32-bit int"
        },
        "trust_policy": {
          "assumptions_allowed": []
        }
      }
    }
  ],
  "protocol_class": "pairwise",
  "realization": {
    "requirement": "required",
    "config_scope": {
      "target": "x86_64-unknown-linux-gnu",
      "features": [],
      "cfg": []
    }
  }
}
