{
  "schema_version": "1.0",
  "interaction_id": "I-year-month-day-ok-to-year-ok",
  "caller": {
    "concept": "YearMonthDay",
    "method": "ok"
  },
  "callee": {
    "concept": "Year",
    "method": "ok"
  },
  "edge_class": [
    "numeric-domain-boundary"
  ],
  "eligibility": "boundary-required",
  "rationale": "YearMonthDay::ok is a conjunction whose first conjunct is the callee's field-range test, so the whole validity predicate the caller returns is only as sound as Year::ok's rejection of the single out-of-domain year -32768, and no other conjunct can mask an error in it.",
  "evidence_links": [
    "E-4",
    "E-12"
  ],
  "reliances": [
    {
      "obligation_id": "YearMonthDayLast.C2",
      "required_assurance": {
        "required_claims": [
          "postcondition-holds"
        ],
        "accepted_evidence_kinds": [
          "creusot-deductive-check"
        ],
        "minimum_scope": {
          "input_domain": "year in [-32767, 32767], month in [1, 12], day in [1, 31], days::rep is a 32-bit int"
        },
        "trust_policy": {
          "assumptions_allowed": []
        }
      }
    }
  ],
  "protocol_class": "pairwise",
  "realization": {
    "requirement": "required",
