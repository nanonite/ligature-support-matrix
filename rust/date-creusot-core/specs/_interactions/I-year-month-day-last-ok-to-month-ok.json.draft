    "numeric-domain-boundary"
  ],
  "eligibility": "boundary-required",
  "rationale": "YearMonthDayLast::ok is exactly the pair of the caller's own field-range tests, so the whole result it returns is decided by Month::ok pinning the month field to 1..=12; the month-length branch the same type's day() relies on is unreachable for any month this call would have accepted.",
  "evidence_links": [
    "E-4",
    "E-12"
  ],
  "reliances": [
    {
      "obligation_id": "YearMonthDayLast.C1",
      "required_assurance": {
