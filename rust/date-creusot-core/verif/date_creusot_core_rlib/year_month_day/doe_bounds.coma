let%span syear_month_day'0 = "/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 637 4 637 52

use int.ComputerDivision
use int.Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant yoe : int

constant doy : int

function doe_bounds [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 640 0 640 37] (yoe: int) (doy: int) : ()

goal vc_doe_bounds: ([%#syear_month_day] yoe >= 0 /\ yoe <= 399 /\ doy >= 0 /\ doy <= 365)
  -> ([@stop_split] [@expl:doe_bounds ensures] [%#syear_month_day'0] let doe = yoe * 365 + ComputerDivision.div yoe 4
    - ComputerDivision.div yoe 100
  + doy in doe >= 0 /\ doe <= 146096)
