  - (if m <= 2 then 1 else 0) in let era = ComputerDivision.div (if ge_log_Int y'0 0 then
    y'0
  else
    y'0 - 399
  ) 400 in let yoe = y'0 - era * 400 in let doy = ComputerDivision.div (153 * (if gt_log_Int m 2 then m - 3 else m + 9)
      + 2) 5
    + d
  - 1 in let doe = yoe * 365 + ComputerDivision.div yoe 4 - ComputerDivision.div yoe 100 + doy in era * 146097 + doe
  - 719468

let to_days_bounded (self: t_YearMonthDay) (return (x: t_Days)) =
{[@stop_split] [@expl:to_days_bounded requires] [%#syear_month_day'8] Int16.to_int self.year.f0 <> - 32768
  /\ 1 <= UInt8.t'int self.month.f0'0
  /\ UInt8.t'int self.month.f0'0 <= 12 /\ 1 <= UInt8.t'int self.day.f0'1 /\ UInt8.t'int self.day.f0'1 <= 31}
  any
  [ return (result: t_Days) ->
  {[@stop_split] [@expl:to_days_bounded ensures] ([@stop_split] [@expl:to_days_bounded ensures #0] [%#syear_month_day'9] ge_log_Int (Int32.to_int result.f0'2) (- 12687428)
      /\ Int32.to_int result.f0'2 <= 11248737)
    /\ ([@stop_split] [@expl:to_days_bounded ensures #1] [%#syear_month_day'10] Int32.to_int result.f0'2
    = days_from_civil (Int16.to_int self.year.f0) (UInt8.t'int self.month.f0'0) (UInt8.t'int self.day.f0'1))}
    (! return {result}) ]

type t_CivilView = { year'0: int; month'0: int; day'0: int }

function year_of_era_from_doe [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 70 0 70 44] (doe: int) : int
 = [%#syear_month_day'25] ComputerDivision.div (doe - ComputerDivision.div doe 1460 + ComputerDivision.div doe 36524
  - ComputerDivision.div doe 146096) 365

axiom year_of_era_from_doe_spec: forall doe: int [year_of_era_from_doe doe]. ([%#syear_month_day'23] ge_log_Int doe 0
      /\ doe <= 146096)
    -> ([%#syear_month_day'24] ge_log_Int (year_of_era_from_doe doe) 0
    /\ year_of_era_from_doe doe <= 399
