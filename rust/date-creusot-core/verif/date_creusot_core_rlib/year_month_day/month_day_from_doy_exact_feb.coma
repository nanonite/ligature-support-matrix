use int.ComputerDivision
use int.Int

function month_length [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day_last.rs" 51 0 51 42] (m: int) (y: int) : int

axiom month_length_spec: forall m: int, y: int [month_length m y]. [%#syear_month_day_last] month_length m y
    = (if m = 2 then
      if ComputerDivision.mod y 4 = 0 /\ (ComputerDivision.mod y 100 <> 0 \/ ComputerDivision.mod y 400 = 0) then
        29
      else
        28
    
    else
      if m = 4 \/ m = 6 \/ m = 9 \/ m = 11 then
        30
      else
        if m = 1 \/ m = 3 \/ m = 5 \/ m = 7 \/ m = 8 \/ m = 10 \/ m = 12 then 31 else 0
    
    )

type tup2_Int_Int = { f0: int; f1: int }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function month_day_from_doy [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 53 0 53 49] (doy: int) : tup2_Int_Int
 = [%#syear_month_day'3] let mp = ComputerDivision.div (5 * doy + 2) 153 in let d = doy
    - ComputerDivision.div (153 * mp + 2) 5
  + 1 in let m = if mp < 10 then mp + 3 else mp - 9 in { f0 = m; f1 = d }

axiom month_day_from_doy_spec: forall doy: int [month_day_from_doy doy]. ([%#syear_month_day'1] ge_log_Int doy 0
      /\ doy <= 365)
    -> ([%#syear_month_day'2] ge_log_Int (month_day_from_doy doy).f0 1
    /\ (month_day_from_doy doy).f0 <= 12
    /\ ge_log_Int (month_day_from_doy doy).f1 1 /\ (month_day_from_doy doy).f1 <= 31)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant y : int

constant d : int

function month_day_from_doy_exact_feb [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 454 0 454 51] (y: int) (d: int) : ()

goal vc_month_day_from_doy_exact_feb: ([%#syear_month_day] 1 <= d /\ d <= month_length 2 y)
  -> ([@stop_split] [@expl:month_day_from_doy_exact_feb ensures] [%#syear_month_day'0] month_day_from_doy (ComputerDivision.div (153
          * 11
        + 2) 5
      + d
    - 1)
  = { f0 = 2; f1 = d })
