axiom doy_of_civil_bounds_feb_spec: forall y: int, d: int. ([%#syear_month_day'3] 1 <= d /\ d <= month_length 2 y)
    -> ([%#syear_month_day'4] let doy = ComputerDivision.div (153 * 11 + 2) 5 + d - 1 in 0 <= doy
    /\ doy <= 365
    /\ (doy <= 364
    \/ d = 29 /\ ComputerDivision.mod y 4 = 0 /\ (ComputerDivision.mod y 100 <> 0 \/ ComputerDivision.mod y 400 = 0)))

