use int.ComputerDivision
use int.Int

function month_length [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day_last.rs" 51 0 51 42] (m: int) (y: int) : int

axiom month_length_spec: forall m: int, y: int [month_length m y]. [%#syear_month_day_last] month_length m y
    = (if m = 2 then
      if ComputerDivision.mod y 4 = 0 /\ (ComputerDivision.mod y 100 <> 0 \/ ComputerDivision.mod y 400 = 0) then
        29
      else
        28
    
    else
      if m = 4 \/ m = 6 \/ m = 9 \/ m = 11 then
        30
      else
        if m = 1 \/ m = 3 \/ m = 5 \/ m = 7 \/ m = 8 \/ m = 10 \/ m = 12 then 31 else 0
    
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function doy_from_civil [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 207 0 207 44] (m: int) (d: int) : int
 = [%#syear_month_day'7] ComputerDivision.div (153 * (if gt_log_Int m 2 then m - 3 else m + 9) + 2) 5 + d - 1

function doy_of_civil_bounds_31 [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 331 0 331 46] (mp: int) (d: int) : ()
