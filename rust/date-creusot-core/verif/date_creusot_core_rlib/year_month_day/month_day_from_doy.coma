(* #"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 53 0 53 49 *)

let%span syear_month_day = "/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 51 11 51 33
let%span syear_month_day'0 = "/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 52 10 52 76

use int.ComputerDivision
use int.Int

type tup2_Int_Int = { f0: int; f1: int }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant doy : int

function month_day_from_doy [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 53 0 53 49] (doy: int) : tup2_Int_Int

goal vc_month_day_from_doy: ([%#syear_month_day] doy >= 0 /\ doy <= 365)
  -> (let mp = ComputerDivision.div (5 * doy + 2) 153 in let d = doy - ComputerDivision.div (153 * mp + 2) 5
  + 1 in if mp < 10 then
    let m = mp + 3 in let result = { f0 = m;
                                     f1 = d } in [@stop_split] [@expl:month_day_from_doy ensures] [%#syear_month_day'0] result.f0
      >= 1
    /\ result.f0 <= 12 /\ result.f1 >= 1 /\ result.f1 <= 31
  else
    let m = mp - 9 in let result = { f0 = m;
                                     f1 = d } in [@stop_split] [@expl:month_day_from_doy ensures] [%#syear_month_day'0] result.f0
      >= 1
    /\ result.f0 <= 12 /\ result.f1 >= 1 /\ result.f1 <= 31
  )
