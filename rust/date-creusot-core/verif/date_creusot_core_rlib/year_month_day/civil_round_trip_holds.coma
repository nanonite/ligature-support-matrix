    if c.month = m then
      let result = c.day
      = d in [@stop_split] [@expl:civil_round_trip_holds ensures] ([@stop_split] [@expl:civil_round_trip_holds ensures #0] [%#syear_month_day'0] result)
      /\ ([@stop_split] [@expl:civil_round_trip_holds ensures #1] [%#syear_month_day'1] let c'0 = civil_from_days (days_from_civil y m d) in result
      = (c'0.year = y /\ c'0.month = m /\ c'0.day = d))
    else
      let result = false in [@stop_split] [@expl:civil_round_trip_holds ensures] ([@stop_split] [@expl:civil_round_trip_holds ensures #0] [%#syear_month_day'0] result)
      /\ ([@stop_split] [@expl:civil_round_trip_holds ensures #1] [%#syear_month_day'1] let c'0 = civil_from_days (days_from_civil y m d) in result
