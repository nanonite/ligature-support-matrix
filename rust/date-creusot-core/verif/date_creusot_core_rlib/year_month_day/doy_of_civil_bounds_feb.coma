let%span syear_month_day = "/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 345 11 345 72
let%span syear_month_day'0 = "/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 347 4 347 41
let%span syear_month_day_last = "/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day_last.rs" 40 10 50 1

use int.ComputerDivision
use int.Int

function month_length [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day_last.rs" 51 0 51 42] (m: int) (y: int) : int

axiom month_length_spec: forall m: int, y: int [month_length m y]. [%#syear_month_day_last] month_length m y
    = (if m = 2 then
      if ComputerDivision.mod y 4 = 0 /\ (ComputerDivision.mod y 100 <> 0 \/ ComputerDivision.mod y 400 = 0) then
        29
      else
        28
    
    else
      if m = 4 \/ m = 6 \/ m = 9 \/ m = 11 then
        30
      else
        if m = 1 \/ m = 3 \/ m = 5 \/ m = 7 \/ m = 8 \/ m = 10 \/ m = 12 then 31 else 0
    
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant y : int

constant d : int

function doy_of_civil_bounds_feb [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 351 0 351 46] (y: int) (d: int) : ()

goal vc_doy_of_civil_bounds_feb: ([%#syear_month_day] 1 <= d /\ d <= month_length 2 y)
  -> (if ComputerDivision.mod y 4 = 0 then
    if ComputerDivision.mod y 100 <> 0 then
      [@stop_split] [@expl:doy_of_civil_bounds_feb ensures] [%#syear_month_day'0] let doy = ComputerDivision.div (153
            * 11
          + 2) 5
        + d
      - 1 in 0 <= doy
      /\ doy <= 365
      /\ (doy <= 364
      \/ d = 29 /\ ComputerDivision.mod y 4 = 0 /\ (ComputerDivision.mod y 100 <> 0 \/ ComputerDivision.mod y 400 = 0))
    else
      if ComputerDivision.mod y 400 = 0 then
        [@stop_split] [@expl:doy_of_civil_bounds_feb ensures] [%#syear_month_day'0] let doy = ComputerDivision.div (153
              * 11
            + 2) 5
          + d
        - 1 in 0 <= doy
        /\ doy <= 365
        /\ (doy <= 364
        \/ d = 29
        /\ ComputerDivision.mod y 4 = 0 /\ (ComputerDivision.mod y 100 <> 0 \/ ComputerDivision.mod y 400 = 0))
      else
        [@stop_split] [@expl:doy_of_civil_bounds_feb ensures] [%#syear_month_day'0] let doy = ComputerDivision.div (153
              * 11
            + 2) 5
          + d
        - 1 in 0 <= doy
        /\ doy <= 365
        /\ (doy <= 364
        \/ d = 29
        /\ ComputerDivision.mod y 4 = 0 /\ (ComputerDivision.mod y 100 <> 0 \/ ComputerDivision.mod y 400 = 0))
    
  
  else
    [@stop_split] [@expl:doy_of_civil_bounds_feb ensures] [%#syear_month_day'0] let doy = ComputerDivision.div (153 * 11
        + 2) 5
      + d
    - 1 in 0 <= doy
    /\ doy <= 365
    /\ (doy <= 364
    \/ d = 29 /\ ComputerDivision.mod y 4 = 0 /\ (ComputerDivision.mod y 100 <> 0 \/ ComputerDivision.mod y 400 = 0))
  )
