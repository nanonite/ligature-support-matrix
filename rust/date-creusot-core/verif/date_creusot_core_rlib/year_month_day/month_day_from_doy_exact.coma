axiom month_day_from_doy_exact_31_spec: forall mp: int, d: int. ([%#syear_month_day'1] (mp = 0
        \/ mp = 2 \/ mp = 4 \/ mp = 5 \/ mp = 7 \/ mp = 9 \/ mp = 10)
      /\ 1 <= d /\ d <= 31)
    -> ([%#syear_month_day'2] month_day_from_doy (ComputerDivision.div (153 * mp + 2) 5 + d - 1)
    = { f0 = (if mp < 10 then mp + 3 else mp - 9); f1 = d })

function month_day_from_doy_exact_feb [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 454 0 454 51] (y: int) (d: int) : ()
