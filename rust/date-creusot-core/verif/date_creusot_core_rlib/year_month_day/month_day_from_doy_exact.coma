axiom month_day_from_doy_exact_feb_spec: forall y: int, d: int. ([%#syear_month_day'3] 1 <= d /\ d <= month_length 2 y)
    -> ([%#syear_month_day'4] month_day_from_doy (ComputerDivision.div (153 * 11 + 2) 5 + d - 1) = { f0 = 2; f1 = d })

function month_day_from_doy_exact_30 [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 438 0 438 51] (mp: int) (d: int) : ()
