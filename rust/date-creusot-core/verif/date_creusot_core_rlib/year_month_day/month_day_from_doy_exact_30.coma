use int.ComputerDivision
use int.Int

type tup2_Int_Int = { f0: int; f1: int }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function month_day_from_doy [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 53 0 53 49] (doy: int) : tup2_Int_Int
 = [%#syear_month_day'3] let mp = ComputerDivision.div (5 * doy + 2) 153 in let d = doy
    - ComputerDivision.div (153 * mp + 2) 5
  + 1 in let m = if mp < 10 then mp + 3 else mp - 9 in { f0 = m; f1 = d }

axiom month_day_from_doy_spec: forall doy: int [month_day_from_doy doy]. ([%#syear_month_day'1] ge_log_Int doy 0
      /\ doy <= 365)
    -> ([%#syear_month_day'2] ge_log_Int (month_day_from_doy doy).f0 1
    /\ (month_day_from_doy doy).f0 <= 12
    /\ ge_log_Int (month_day_from_doy doy).f1 1 /\ (month_day_from_doy doy).f1 <= 31)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant mp : int

constant d : int

function month_day_from_doy_exact_30 [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 438 0 438 51] (mp: int) (d: int) : ()

goal vc_month_day_from_doy_exact_30: ([%#syear_month_day] (mp = 1 \/ mp = 3 \/ mp = 6 \/ mp = 8) /\ 1 <= d /\ d <= 30)
  -> ([@stop_split] [@expl:month_day_from_doy_exact_30 ensures] [%#syear_month_day'0] month_day_from_doy (ComputerDivision.div (153
          * mp
        + 2) 5
      + d
    - 1)
  = { f0 = mp + 3; f1 = d })
