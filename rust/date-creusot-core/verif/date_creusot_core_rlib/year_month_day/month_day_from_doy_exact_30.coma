use int.ComputerDivision
use int.Int

type tup2_Int_Int = { f0: int; f1: int }

function month_day_from_doy [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 53 0 53 49] (doy: int) : tup2_Int_Int
 = [%#syear_month_day'3] let mp = ComputerDivision.div (5 * doy + 2) 153 in let d = doy
    - ComputerDivision.div (153 * mp + 2) 5
  + 1 in let m = if mp < 10 then mp + 3 else mp - 9 in { f0 = m; f1 = d }

axiom month_day_from_doy_spec: forall doy: int [month_day_from_doy doy]. ([%#syear_month_day'1] doy >= 0 /\ doy <= 365)
    -> ([%#syear_month_day'2] (month_day_from_doy doy).f0 >= 1
    /\ (month_day_from_doy doy).f0 <= 12 /\ (month_day_from_doy doy).f1 >= 1 /\ (month_day_from_doy doy).f1 <= 31)

meta "compute_max_steps" 1000000

