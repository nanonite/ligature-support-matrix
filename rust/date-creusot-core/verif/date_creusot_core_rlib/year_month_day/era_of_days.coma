use int.ComputerDivision
use int.Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant era : int

constant doe : int

function era_of_days [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 203 0 203 38] (era: int) (doe: int) : ()

goal vc_era_of_days: ([%#syear_month_day] 0 <= doe /\ doe <= 146096)
