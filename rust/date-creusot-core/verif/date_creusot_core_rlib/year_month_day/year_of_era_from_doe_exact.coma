function div_365_of_era_end [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 184 0 184 33] (k: int) : ()
 = [%#syear_month_day'20] ()

axiom div_365_of_era_end_spec: forall k: int. ([%#syear_month_day'9] k >= 1)
    -> ([%#syear_month_day'10] ComputerDivision.div (365 * k - 1) 365 = k - 1)

