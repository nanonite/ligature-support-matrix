predicate valid_era_day [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 98 0 98 48] (yoe: int) (doy: int) =
  [%#syear_month_day'11] 0 <= doy
  /\ doy <= 365 /\ (doy <= 364 \/ ComputerDivision.mod yoe 4 = 3 /\ yoe <> 99 /\ yoe <> 199 /\ yoe <> 299)

function year_of_era_from_doe [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 70 0 70 44] (doe: int) : int
 = [%#syear_month_day'14] ComputerDivision.div (doe - ComputerDivision.div doe 1460 + ComputerDivision.div doe 36524
  - ComputerDivision.div doe 146096) 365

axiom year_of_era_from_doe_spec: forall doe: int [year_of_era_from_doe doe]. ([%#syear_month_day'12] doe >= 0
      /\ doe <= 146096)
    -> ([%#syear_month_day'13] year_of_era_from_doe doe >= 0
    /\ year_of_era_from_doe doe <= 399
    /\ doe
        - (365 * year_of_era_from_doe doe + ComputerDivision.div (year_of_era_from_doe doe) 4
        - ComputerDivision.div (year_of_era_from_doe doe) 100)
      >= 0
    /\ doe
      - (365 * year_of_era_from_doe doe + ComputerDivision.div (year_of_era_from_doe doe) 4
      - ComputerDivision.div (year_of_era_from_doe doe) 100)
    <= 365)

function era_year_start [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 78 0 78 38] (yoe: int) : int
 = [%#syear_month_day'15] 365 * yoe + ComputerDivision.div yoe 4 - ComputerDivision.div yoe 100

function century_of_era_year [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 114 0 114 36] (yoe: int) : ()
 = [%#syear_month_day'16] ()

axiom century_of_era_year_spec: forall yoe: int. ([%#syear_month_day'1] yoe >= 0 /\ yoe <= 399)
    -> ([%#syear_month_day'2] ComputerDivision.div yoe 100 = ComputerDivision.div (ComputerDivision.div yoe 4) 25)

function era_quotients [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 145 0 145 54] (h: int) (u: int) (r: int) (doy: int) : ()
 = [%#syear_month_day'17] let c = 24 * h + u + 365 * r + doy in if c < 1460 then
    ()
  else
    if not (u = 24 /\ r = 3 /\ doy = 365) then () else if h = 3 then () else ()


axiom era_quotients_spec: forall h: int, u: int, r: int, doy: int. ([%#syear_month_day'3] 0 <= h
      /\ h <= 3 /\ 0 <= u /\ u <= 24 /\ 0 <= r /\ r <= 3 /\ 0 <= doy /\ doy <= 365)
    -> ([%#syear_month_day'4] let doe = 36524 * h + 1461 * u + 365 * r + doy in let c = 24 * h + u + 365 * r
    + doy in if c < 1460 then
      ComputerDivision.div doe 1460 = 25 * h + u
      /\ ComputerDivision.div doe 36524 = h /\ ComputerDivision.div doe 146096 = 0
    else
      if not (u = 24 /\ r = 3 /\ doy = 365) then
        ComputerDivision.div doe 1460 = 25 * h + u + 1
        /\ ComputerDivision.div doe 36524 = h /\ ComputerDivision.div doe 146096 = 0
      else
        if h = 3 then
          ComputerDivision.div doe 1460 = 25 * h + u + 1
          /\ ComputerDivision.div doe 36524 = h + 1 /\ ComputerDivision.div doe 146096 = 1
        else
          ComputerDivision.div doe 1460 = 25 * h + u + 1
          /\ ComputerDivision.div doe 36524 = h + 1 /\ ComputerDivision.div doe 146096 = 0
      
    
    )

function div_365_of_nonneg_digit [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 168 0 168 46] (k: int) (w: int) : ()
 = [%#syear_month_day'18] ()

axiom div_365_of_nonneg_digit_spec: forall k: int, w: int. ([%#syear_month_day'5] k >= 0 /\ w >= 0)
    -> ([%#syear_month_day'6] ComputerDivision.div (365 * k + w) 365 = k + ComputerDivision.div w 365)

function div_365_of_year [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 175 0 175 38] (r: int) (e: int) : ()
