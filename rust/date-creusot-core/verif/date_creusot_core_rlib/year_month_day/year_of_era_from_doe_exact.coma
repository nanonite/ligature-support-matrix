constant yoe : int

constant doy : int

function year_of_era_from_doe_exact [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 506 0 506 53] (yoe: int) (doy: int) : ()

goal vc_year_of_era_from_doe_exact: ([%#syear_month_day] yoe >= 0 /\ yoe <= 399 /\ valid_era_day yoe doy)
  -> (let q = ComputerDivision.div yoe 4 in let r = ComputerDivision.mod yoe 4 in let h = ComputerDivision.div q 25 in let u = ComputerDivision.mod q 25 in let c = 24
        * h
      + u
    + 365 * r
  + doy in ([@stop_split] [@expl:century_of_era_year requires] [%#syear_month_day'1] yoe >= 0 /\ yoe <= 399)
  /\ (([@stop_split] [@expl:century_of_era_year ensures] [%#syear_month_day'2] ComputerDivision.div yoe 100
    = ComputerDivision.div (ComputerDivision.div yoe 4) 25)
  -> (let _ = century_of_era_year yoe in ([@stop_split] [@expl:era_quotients requires] [%#syear_month_day'3] 0 <= h
    /\ h <= 3 /\ 0 <= u /\ u <= 24 /\ 0 <= r /\ r <= 3 /\ 0 <= doy /\ doy <= 365)
  /\ (([@stop_split] [@expl:era_quotients ensures] [%#syear_month_day'4] let doe = 36524 * h + 1461 * u + 365 * r
    + doy in let c'0 = 24 * h + u + 365 * r + doy in if c'0 < 1460 then
      ComputerDivision.div doe 1460 = 25 * h + u
      /\ ComputerDivision.div doe 36524 = h /\ ComputerDivision.div doe 146096 = 0
    else
      if not (u = 24 /\ r = 3 /\ doy = 365) then
        ComputerDivision.div doe 1460 = 25 * h + u + 1
        /\ ComputerDivision.div doe 36524 = h /\ ComputerDivision.div doe 146096 = 0
      else
        if h = 3 then
          ComputerDivision.div doe 1460 = 25 * h + u + 1
          /\ ComputerDivision.div doe 36524 = h + 1 /\ ComputerDivision.div doe 146096 = 1
        else
          ComputerDivision.div doe 1460 = 25 * h + u + 1
          /\ ComputerDivision.div doe 36524 = h + 1 /\ ComputerDivision.div doe 146096 = 0
      
    
    )
  -> (let _ = era_quotients h u r doy in if c < 1460 then
    ([@stop_split] [@expl:div_365_of_nonneg_digit requires] [%#syear_month_day'5] 4 * q >= 0 /\ 365 * r + doy >= 0)
    /\ (([@stop_split] [@expl:div_365_of_nonneg_digit ensures] [%#syear_month_day'6] ComputerDivision.div (365 * 4 * q
          + 365 * r
        + doy) 365
      = 4 * q + ComputerDivision.div (365 * r + doy) 365)
    -> (let _ = div_365_of_nonneg_digit (4 * q) (365 * r
    + doy) in ([@stop_split] [@expl:div_365_of_year requires] [%#syear_month_day'7] r >= 0 /\ 0 <= doy /\ doy <= 364)
    /\ (([@stop_split] [@expl:div_365_of_year ensures] [%#syear_month_day'8] ComputerDivision.div (365 * r + doy) 365
      = r)
    -> (let _ = div_365_of_year r doy in [@stop_split] [@expl:year_of_era_from_doe_exact ensures] [%#syear_month_day'0] year_of_era_from_doe (era_year_start yoe
      + doy)
    = yoe))))
  else
    if u = 24 then
      if r = 3 then
        if not doy = 365 then
          ([@stop_split] [@expl:div_365_of_nonneg_digit requires] [%#syear_month_day'5] 4 * q >= 0
            /\ 365 * r + doy - 1 >= 0)
          /\ (([@stop_split] [@expl:div_365_of_nonneg_digit ensures] [%#syear_month_day'6] ComputerDivision.div (365 * 4
                * q
              + (365 * r + doy - 1)) 365
            = 4 * q + ComputerDivision.div (365 * r + doy - 1) 365)
          -> (let _ = div_365_of_nonneg_digit (4 * q) (365 * r + doy
          - 1) in ([@stop_split] [@expl:div_365_of_year requires] [%#syear_month_day'7] r >= 0
            /\ 0 <= doy - 1 /\ doy - 1 <= 364)
          /\ (([@stop_split] [@expl:div_365_of_year ensures] [%#syear_month_day'8] ComputerDivision.div (365 * r
              + (doy - 1)) 365
            = r)
          -> (let _ = div_365_of_year r (doy
          - 1) in [@stop_split] [@expl:year_of_era_from_doe_exact ensures] [%#syear_month_day'0] year_of_era_from_doe (era_year_start yoe
            + doy)
          = yoe))))
        else
          if h = 3 then
            ([@stop_split] [@expl:div_365_of_era_end requires] [%#syear_month_day'9] 4 * q + 4 >= 1)
            /\ (([@stop_split] [@expl:div_365_of_era_end ensures] [%#syear_month_day'10] ComputerDivision.div (365
                  * (4 * q + 4)
                - 1) 365
              = 4 * q + 4 - 1)
            -> (let _ = div_365_of_era_end (4 * q
            + 4) in [@stop_split] [@expl:year_of_era_from_doe_exact ensures] [%#syear_month_day'0] year_of_era_from_doe (era_year_start yoe
              + doy)
            = yoe))
          else
            [@stop_split] [@expl:year_of_era_from_doe_exact ensures] [%#syear_month_day'0] year_of_era_from_doe (era_year_start yoe
              + doy)
            = yoe
        
      
      else
        if not false then
          ([@stop_split] [@expl:div_365_of_nonneg_digit requires] [%#syear_month_day'5] 4 * q >= 0
            /\ 365 * r + doy - 1 >= 0)
          /\ (([@stop_split] [@expl:div_365_of_nonneg_digit ensures] [%#syear_month_day'6] ComputerDivision.div (365 * 4
                * q
              + (365 * r + doy - 1)) 365
            = 4 * q + ComputerDivision.div (365 * r + doy - 1) 365)
          -> (let _ = div_365_of_nonneg_digit (4 * q) (365 * r + doy
          - 1) in ([@stop_split] [@expl:div_365_of_year requires] [%#syear_month_day'7] r >= 0
            /\ 0 <= doy - 1 /\ doy - 1 <= 364)
          /\ (([@stop_split] [@expl:div_365_of_year ensures] [%#syear_month_day'8] ComputerDivision.div (365 * r
              + (doy - 1)) 365
            = r)
          -> (let _ = div_365_of_year r (doy
          - 1) in [@stop_split] [@expl:year_of_era_from_doe_exact ensures] [%#syear_month_day'0] year_of_era_from_doe (era_year_start yoe
            + doy)
          = yoe))))
        else
          if h = 3 then
            ([@stop_split] [@expl:div_365_of_era_end requires] [%#syear_month_day'9] 4 * q + 4 >= 1)
            /\ (([@stop_split] [@expl:div_365_of_era_end ensures] [%#syear_month_day'10] ComputerDivision.div (365
                  * (4 * q + 4)
                - 1) 365
              = 4 * q + 4 - 1)
            -> (let _ = div_365_of_era_end (4 * q
            + 4) in [@stop_split] [@expl:year_of_era_from_doe_exact ensures] [%#syear_month_day'0] year_of_era_from_doe (era_year_start yoe
              + doy)
            = yoe))
          else
            [@stop_split] [@expl:year_of_era_from_doe_exact ensures] [%#syear_month_day'0] year_of_era_from_doe (era_year_start yoe
              + doy)
            = yoe
        
      
    
    else
      if not false then
        ([@stop_split] [@expl:div_365_of_nonneg_digit requires] [%#syear_month_day'5] 4 * q >= 0
          /\ 365 * r + doy - 1 >= 0)
        /\ (([@stop_split] [@expl:div_365_of_nonneg_digit ensures] [%#syear_month_day'6] ComputerDivision.div (365 * 4
              * q
            + (365 * r + doy - 1)) 365
          = 4 * q + ComputerDivision.div (365 * r + doy - 1) 365)
        -> (let _ = div_365_of_nonneg_digit (4 * q) (365 * r + doy
        - 1) in ([@stop_split] [@expl:div_365_of_year requires] [%#syear_month_day'7] r >= 0
          /\ 0 <= doy - 1 /\ doy - 1 <= 364)
        /\ (([@stop_split] [@expl:div_365_of_year ensures] [%#syear_month_day'8] ComputerDivision.div (365 * r
            + (doy - 1)) 365
          = r)
        -> (let _ = div_365_of_year r (doy
        - 1) in [@stop_split] [@expl:year_of_era_from_doe_exact ensures] [%#syear_month_day'0] year_of_era_from_doe (era_year_start yoe
          + doy)
        = yoe))))
      else
        if h = 3 then
          ([@stop_split] [@expl:div_365_of_era_end requires] [%#syear_month_day'9] 4 * q + 4 >= 1)
          /\ (([@stop_split] [@expl:div_365_of_era_end ensures] [%#syear_month_day'10] ComputerDivision.div (365
                * (4 * q + 4)
              - 1) 365
            = 4 * q + 4 - 1)
          -> (let _ = div_365_of_era_end (4 * q
          + 4) in [@stop_split] [@expl:year_of_era_from_doe_exact ensures] [%#syear_month_day'0] year_of_era_from_doe (era_year_start yoe
            + doy)
          = yoe))
        else
          [@stop_split] [@expl:year_of_era_from_doe_exact ensures] [%#syear_month_day'0] year_of_era_from_doe (era_year_start yoe
            + doy)
          = yoe
      
    
  
  )))))
