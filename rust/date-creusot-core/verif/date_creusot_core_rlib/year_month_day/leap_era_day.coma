use int.ComputerDivision
use int.Int

function div_4_era_shift [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 226 0 226 38] (x: int) (e: int) : ()
 = [%#syear_month_day'4] ()

axiom div_4_era_shift_spec: forall x: int, e: int. [%#syear_month_day'1] (ComputerDivision.mod (x - 400 * e) 4 = 0)
    = (ComputerDivision.mod x 4 = 0)

function div_100_era_shift [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 231 0 231 40] (x: int) (e: int) : ()
 = [%#syear_month_day'5] ()

