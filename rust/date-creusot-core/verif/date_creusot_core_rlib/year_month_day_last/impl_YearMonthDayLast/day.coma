use creusot.int.Int16
use creusot.int.UInt8
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_Year = { f0: Int16.t }

type t_Month = { f0'0: UInt8.t }

type t_YearMonthDayLast = { year: t_Year; month: t_Month }

let is_leap (self: t_Year) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:is_leap ensures] [%#syear] result
    = (ComputerDivision.mod (Int16.to_int self.f0) 4 = 0
    /\ (ComputerDivision.mod (Int16.to_int self.f0) 100 <> 0 \/ ComputerDivision.mod (Int16.to_int self.f0) 400 = 0))}
    (! return {result}) ]

type t_Day = { f0'1: UInt8.t }

function month_length [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day_last.rs" 51 0 51 42] (m: int) (y: int) : int
 = [%#syear_month_day_last'20] if m = 2 then
    if ComputerDivision.mod y 4 = 0 /\ (ComputerDivision.mod y 100 <> 0 \/ ComputerDivision.mod y 400 = 0) then
      29
    else
      28
  
  else
    if m = 4 \/ m = 6 \/ m = 9 \/ m = 11 then
      30
    else
      if m = 1 \/ m = 3 \/ m = 5 \/ m = 7 \/ m = 8 \/ m = 10 \/ m = 12 then 31 else 0
  


axiom month_length_spec: forall m: int, y: int [month_length m y]. [%#syear_month_day_last'19] month_length m y
    = (if m = 2 then
      if ComputerDivision.mod y 4 = 0 /\ (ComputerDivision.mod y 100 <> 0 \/ ComputerDivision.mod y 400 = 0) then
        29
      else
        28
    
    else
      if m = 4 \/ m = 6 \/ m = 9 \/ m = 11 then
        30
      else
        if m = 1 \/ m = 3 \/ m = 5 \/ m = 7 \/ m = 8 \/ m = 10 \/ m = 12 then 31 else 0
    
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

