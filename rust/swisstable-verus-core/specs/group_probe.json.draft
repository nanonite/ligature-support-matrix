{
  "schema_version": "1.0",
  "concept": "GroupProbe",
  "kind": "struct",
  "cluster": "probing",
  "english_description": "A sixteen-slot window over a table's control bytes that answers which slots hold a tag, which are full, and which are free to reuse.",
  "verifier": "verus",
  "queries": [
    {
      "english": "give the slots of this group that are full with the given tag",
      "rust_sig": "fn match_full(&self, h2: u8) -> u16",
      "pure": true,
      "witness_required": true
    },
    {
      "english": "give the slots of this group that are empty or deleted",
      "rust_sig": "fn match_empty_or_deleted(&self) -> u16",
      "pure": true,
      "witness_required": false
    },
    {
      "english": "count the empty slots of this group",
      "rust_sig": "fn count_empty(&self) -> usize",
      "pure": true,
      "witness_required": false
    }
  ],
  "commands": [
    {
      "english": "load the group from the control bytes at a slot index",
      "rust_sig": "fn load(&mut self, slot: usize)"
    }
  ],
  "constraints": [
    {
      "english": "A group's sixteen control bytes lie wholly inside the table's control array: that window must be established when the group is loaded and still hold whenever a mask is read from it.",
      "logic": "self.base + 16 <= self.capacity",
      "kind": "precondition",
      "source": "hand",
      "applies_to": [
        "load",
        "match_full",
        "match_empty_or_deleted"
      ],
      "id": "C001"
    },
    {
      "english": "Matching a tag sets a group's bit for a slot exactly when that slot is full and its tag is the given value.",
      "logic": "self.bit_i_match(h2) == (self.ctrl(i) >= 0 && self.ctrl(i) as u8 == h2)",
      "kind": "postcondition",
      "source": "hand",
      "applies_to": [
        "match_full"
      ],
      "id": "C002"
    },
    {
      "english": "The empty-or-deleted mask sets a group's bit for a slot exactly when that slot is empty or deleted.",
      "logic": "self.bit_i_free() == (self.ctrl(i) == EMPTY || self.ctrl(i) == DELETED)",
      "kind": "postcondition",
      "source": "hand",
      "applies_to": [
        "match_empty_or_deleted"
      ],
      "id": "C003"
    },
    {
      "english": "A group never covers the sentinel byte at index capacity.",
      "logic": "self.base + 16 <= self.capacity",
      "kind": "invariant",
      "source": "hand",
      "applies_to": [
        "load",
        "match_full",
        "match_empty_or_deleted"
      ],
      "id": "C004"
    },
    {
      "english": "Every group's answer is a function of its own sixteen control bytes and of nothing else.",
      "logic": "self.result_depends_only_on(self.ctrl_window)",
      "kind": "invariant",
      "source": "hand",
      "applies_to": [
        "match_full",
        "match_empty_or_deleted",
        "count_empty"
      ],
      "id": "C005"
    }
  ],
  "adversary_table": [
    {
      "scenario": "a group whose window would include the sentinel at index capacity",
      "violates": "C001",
      "resolution": "reject: the group is not loaded"
    },
    {
      "scenario": "a table holding both deleted and empty slots in one group, the steady state after an erase",
      "violates": "C003",
      "resolution": "preserve reference behaviour: both states set the free bit"
    },
    {
      "scenario": "a small table whose capacity is below the group width, where the trailing control bytes are padding",
      "violates": "C004",
      "resolution": "reject: only the first capacity bytes after the sentinel are real slots"
    }
  ],
  "source_references": [
    {
      "kind": "reference-implementation",
      "citation_or_path": "absl/container/internal/hashtable_control_bytes.h",
      "notes": "GroupSse2Impl; the portable Group computes the same masks"
    },
    {
      "kind": "issue",
      "citation_or_path": "chainlink #36",
      "notes": "SIMD reach is this pilot's open decision, not this concept's"
    }
  ]
}
