{
  "schema_version": "1.0",
  "bridge_id": "BR-GROUPPROBE-FREE-WINDOW-001",
  "boundary_id": "raw_table_find__to__group_probe_match_empty_or_deleted",
  "callee_requirement": "GroupProbe.C001",
  "available_contract_facts": [
    {
      "obligation_id": "RawTable.C001",
      "role": "invariant"
    },
    {
      "obligation_id": "RawTable.C004",
      "role": "caller-precondition"
    }
  ],
  "required_local_facts": [
    {
      "fact_id": "group_base",
      "expression": "seq.offset()"
    },
    {
      "fact_id": "group_width",
      "expression": "GROUP_WIDTH"
    }
  ],
  "target_expression": "GroupProbe::load(seq.offset()).match_empty_or_deleted()",
  "protocol_class": "pairwise",
  "bridge_logic": {
    "bindings": {
      "self": "RawTable",
      "seq": "ProbeSeq",
      "GROUP_WIDTH": "usize"
    },
    "premises": [
      "self.capacity() == capacity_mask + 1",
      "self.capacity() >= GROUP_WIDTH",
      "seq.offset() + GROUP_WIDTH <= self.capacity()"
    ],
    "conclusion": {
      "obligation_id": "GroupProbe.C001"
    }
  }
}
