# Scaffolded by `ligature scaffold-crate` (chainlink #115).
#
# Generated from this workspace's project descriptor. These exact bytes
# are a pure function of the declared crate entry, so the scaffold is
# reproducible: the same descriptor yields this manifest, and a re-run
# over an unchanged workspace rewrites nothing.
#
# This file declares no behaviour and no dependency. Implementation and
# dependency declarations belong to a work package (Stage 7) and the
# ordinary worker path; scaffold-crate writes a crate manifest and its
# canonical source skeleton, and nothing else.
[package]
name = "swisstable-verus-core"
version = "0.1.0"
edition = "2021"

[lib]
path = "src/lib.rs"

# `vstd` is Verus's standard library and is not re-exported by `rustc`: it has to
# be a real dependency for Cargo to hand it to the driver.  This is the Verus
# analogue of date-creusot-core's `creusot-std = "0.12.0-dev"` line, and the pin is
# the one the pinned Verus release (0.2026.05.24.ecee80a) expects -- `cargo verus`
# marks the crate it resolves with the `is-vstd` feature, so the version has to
# agree with the driver or the two disagree about what `vstd` is.
[dependencies]
vstd = "=0.0.0-2026-05-24-0157"

# `cargo verus verify` refuses to verify a crate that has not opted in, and says
# so:
#
#   WARNING: You asked for verification, but cargo did not find any crates that
#   opted into verification.
#
# Without this, `cargo verus verify` silently degrades to `cargo check`.
[package.metadata.verus]
verify = true

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(verus_only)'] }
