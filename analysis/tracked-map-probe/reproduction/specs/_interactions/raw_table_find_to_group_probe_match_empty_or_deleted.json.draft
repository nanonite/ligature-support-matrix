{
  "schema_version": "1.0",
  "interaction_id": "raw_table_find_to_group_probe_match_empty_or_deleted",
  "caller": {
    "concept": "RawTable",
    "method": "find"
  },
  "callee": {
    "concept": "GroupProbe",
    "method": "match_empty_or_deleted"
  },
  "edge_class": [
    "stateful"
  ],
  "eligibility": "boundary-required",
  "rationale": "Insert-slot search must stop at the first group holding any deleted byte as well as any empty one, or the table stops reusing capacity and, worse, never terminates its probe on a table that has only tombstones left.",
  "protocol_class": "pairwise",
  "realization": {
    "requirement": "required",
