{
  "schema_version": "1.0",
  "concept": "ProbeSeq",
  "kind": "struct",
  "cluster": "probing",
  "english_description": "The bounded triple-step probe sequence that walks a table from a start offset to every slot exactly once.",
  "verifier": "verus",
  "queries": [
    {
      "english": "give the current slot index",
      "rust_sig": "fn offset(&self) -> usize",
      "pure": true,
      "witness_required": false
    },
    {
      "english": "give the zero-based probe index",
      "rust_sig": "fn index(&self) -> usize",
      "pure": true,
      "witness_required": false
    },
    {
      "english": "give the slot index some steps ahead",
      "rust_sig": "fn offset_at(&self, i: usize) -> usize",
      "pure": true,
      "witness_required": false
    }
  ],
  "commands": [
    {
      "english": "build a sequence from a capacity mask and a start hash",
      "rust_sig": "fn from_capacity_and_h1(&mut self, capacity_mask: usize, h1: u64)"
    },
    {
      "english": "advance to the next probe position",
      "rust_sig": "fn advance(&mut self)"
    }
  ],
  "constraints": [
    {
      "english": "The capacity mask is two to the n minus one for at least four bits, both when the sequence is built and whenever a slot offset is read from it.",
      "logic": "self.capacity_mask + 1 == (1 << self.capacity_bits) && self.capacity_bits >= 4",
      "kind": "precondition",
      "source": "hand",
      "applies_to": [
        "from_capacity_and_h1",
        "offset",
        "offset_at"
      ],
      "id": "C001"
    },
    {
      "english": "The current slot index is always strictly less than the capacity.",
      "logic": "self.offset_ < self.capacity_mask + 1",
      "kind": "invariant",
      "source": "hand",
      "applies_to": [
        "offset",
        "offset_at"
      ],
      "id": "C002"
    },
    {
      "english": "The probe index is a multiple of the group width and never exceeds the capacity.",
      "logic": "self.index_ % 16 == 0 && self.index_ <= self.capacity_mask + 1",
      "kind": "invariant",
      "source": "hand",
      "applies_to": [
        "index"
      ],
      "id": "C003"
    },
    {
      "english": "After advancing, the new slot index is the old one plus the new probe index, masked by the capacity.",
      "logic": "self.offset_ == (self.prev_offset_ + self.index_) & self.capacity_mask",
      "kind": "postcondition",
      "source": "hand",
      "applies_to": [
        "advance"
      ],
      "id": "C004"
    }
  ],
  "adversary_table": [
    {
      "scenario": "a capacity that is not two to the n minus one, so the mask is not a whole number of slots",
      "violates": "C001",
      "resolution": "reject: no probe sequence is built for such a capacity"
    },
    {
      "scenario": "advancing on a table with no non-full slot left, which would wrap forever",
      "violates": "C003",
      "resolution": "reject: the caller's loop is required to establish a non-full slot exists"
    }
  ],
  "source_references": [
    {
      "kind": "reference-implementation",
      "citation_or_path": "absl/container/internal/raw_hash_set.h",
      "notes": "probe_seq"
    }
  ]
}
