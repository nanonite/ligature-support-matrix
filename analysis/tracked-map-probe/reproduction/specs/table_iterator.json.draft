{
  "schema_version": "1.0",
  "concept": "TableIterator",
  "kind": "struct",
  "cluster": "iteration",
  "english_description": "A cursor over a table's slots that visits only full slots, in ascending control-array index, and stops at the sentinel.",
  "verifier": "verus",
  "queries": [
    {
      "english": "tell whether the cursor has run past the last element",
      "rust_sig": "fn is_end(&self) -> bool",
      "pure": true,
      "witness_required": false
    },
    {
      "english": "give the control index the cursor rests on",
      "rust_sig": "fn offset(&self) -> usize",
      "pure": true,
      "witness_required": false
    }
  ],
  "commands": [
    {
      "english": "advance to the next full slot or to the end",
      "rust_sig": "fn advance(&mut self)"
    },
    {
      "english": "move a default cursor onto the first full slot",
      "rust_sig": "fn rewind_to_full(&mut self)"
    }
  ],
  "constraints": [
    {
      "english": "A cursor that is not at the end never rests on an empty or deleted slot.",
      "logic": "self.is_end() || self.ctrl(self.offset_) >= 0",
      "kind": "invariant",
      "source": "hand",
      "applies_to": [
        "is_end",
        "offset"
      ],
      "id": "C001"
    },
    {
      "english": "After advancing, the cursor rests on a full slot or reports the end.",
      "logic": "self.is_end() || self.ctrl(self.offset_) >= 0",
      "kind": "postcondition",
      "source": "hand",
      "applies_to": [
        "advance"
      ],
      "id": "C002"
    },
    {
      "english": "The control index never passes the sentinel at index capacity.",
      "logic": "self.offset_ <= self.capacity",
      "kind": "invariant",
      "source": "hand",
      "applies_to": [
        "offset",
        "advance"
      ],
      "id": "C003"
    },
    {
      "english": "The order in which a cursor visits elements follows slot layout and is not part of the container's contract.",
      "logic": "self.order_is_unspecified()",
      "kind": "invariant",
      "source": "hand",
      "applies_to": [
        "advance",
        "rewind_to_full"
      ],
      "id": "C004"
    }
  ],
  "adversary_table": [
    {
      "scenario": "advancing a cursor that already sits on a deleted slot, which a stale cursor would",
      "violates": "C001",
      "resolution": "reject: the cursor is repaired before use, never trusted where it is"
    },
    {
      "scenario": "a cursor stopped by the sentinel rather than by running off the control array",
      "violates": "C003",
      "resolution": "preserve reference behaviour: the sentinel byte is the stop condition"
    }
  ],
  "source_references": [
    {
      "kind": "reference-implementation",
      "citation_or_path": "absl/container/internal/raw_hash_set.h",
      "notes": "iterator and skip_empty_or_deleted"
    }
  ],
  "depends_on": [
    {
      "crate": "swisstable-verus-core",
      "concept": "ControlBytes",
      "reason": "the cursor decides where to stop purely by reading the control byte under it, so the stop condition is the byte encoding"
    }
  ]
}
