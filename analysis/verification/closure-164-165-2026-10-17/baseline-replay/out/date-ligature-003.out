### CMD
cd date-creusot && cp project-descriptor.json /tmp/pd.json && python3 -c 'import json,pathlib; p=pathlib.Path("project-descriptor.json"); d=json.loads(p.read_text()); d["closure_kind"]="deductive"; p.write_text(json.dumps(d,indent=2)+"\n")' && python3 tools/ligature/ligature.pyz status --json && python3 tools/ligature/ligature.pyz check --json; cp /tmp/pd.json project-descriptor.json
