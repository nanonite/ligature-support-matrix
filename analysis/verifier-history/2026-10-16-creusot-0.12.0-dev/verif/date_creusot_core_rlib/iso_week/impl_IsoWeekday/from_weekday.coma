(* iso_week::IsoWeekday *)

let%span siso_week = "/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/iso_week.rs" 105 19 105 40
let%span siso_week'0 = "/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/iso_week.rs" 103 14 103 63
let%span siso_week'1 = "/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/iso_week.rs" 19 10 19 51

use creusot.int.UInt8
use creusot.prelude.Any

type t_Weekday = { f0: UInt8.t }

let to_iso_encoding (z: UInt8.t) (return (x: UInt8.t)) = any
  [ return (result: UInt8.t) -> {[@stop_split] [@expl:to_iso_encoding ensures] [%#siso_week'1] UInt8.t'int result
    = (if UInt8.t'int z = 0 then 7 else UInt8.t'int z)}
    (! return {result}) ]

type t_IsoWeekday = { f0'0: UInt8.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let from_weekday [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/iso_week.rs" 104 4 104 72]
  (wd: t_Weekday) (return (x: t_IsoWeekday)) = (! bb0
  [ bb0 = s0
    [ s0 = to_iso_encoding [%#siso_week] {wd.f0} (fun (_x: UInt8.t) -> [ &_4 <- _x ] s1)
    | s1 = [ &_ret <- { f0'0 = _4 } ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: t_IsoWeekday = Any.any_l () | & wd: t_Weekday = wd | & _4: UInt8.t = Any.any_l () ])
  [ return (result: t_IsoWeekday) -> {[@stop_split] [@expl:from_weekday ensures] [%#siso_week'0] UInt8.t'int result.f0'0
    = (if UInt8.t'int wd.f0 = 0 then 7 else UInt8.t'int wd.f0)}
    (! return {result}) ]
