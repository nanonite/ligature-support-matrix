(* year_month_day::YearMonthDay *)

use creusot.int.Int16
use creusot.int.UInt8
use creusot.prelude.Any

type t_Year = { f0: Int16.t }

type t_Month = { f0'0: UInt8.t }

type t_Day = { f0'1: UInt8.t }

type t_YearMonthDay = { year: t_Year; month: t_Month; day: t_Day }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let new [#"/home/goya/storage/full-ligature-port-workspace/date-creusot/rust/date-creusot-core/src/year_month_day.rs" 790 4 790 84]
  (year'0: t_Year) (month'0: t_Month) (day'0: t_Day) (return (x: t_YearMonthDay)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- { year = year'0; month = month'0; day = day'0 } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_YearMonthDay = Any.any_l ()
  | & year'0: t_Year = year'0
  | & month'0: t_Month = month'0
  | & day'0: t_Day = day'0 ]) [ return (result: t_YearMonthDay) -> (! return {result}) ]
