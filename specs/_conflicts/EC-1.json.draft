{
  "schema_version": "1.0",
  "conflict_id": "EC-1",
  "evidence": [
    "E-007",
    "E-008"
  ],
  "status": "resolved",
  "resolution": {
    "selected_authority": "E-008",
    "disposition_of_other": "incidental",
    "rationale": "E-007 and E-008 are both true and disagree about what they add up to. E-007 is the implementation fact: within one table, slots are visited in ascending control index. E-008 is the intent: the per-table seed is mixed into H1 specifically to randomise that order, so no enumeration order survives a different seed. E-008 wins because it is the authority that decides what a caller may rely on -- E-007 only describes one table's layout. The resolution binds the port and the oracle: iteration order is not an observable property, so no concept constraint may require an order and no oracle case may compare one. TableIterator.C004 and SwissTable.C004 are written from E-008, and chainlink #37 owns the oracle-side half of the same decision."
  }
}
