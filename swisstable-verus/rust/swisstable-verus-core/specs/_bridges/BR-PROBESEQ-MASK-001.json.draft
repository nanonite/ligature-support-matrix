{
  "schema_version": "1.0",
  "bridge_id": "BR-PROBESEQ-MASK-001",
  "boundary_id": "raw_table_find__to__probe_seq_offset",
  "callee_requirement": "ProbeSeq.C001",
  "available_contract_facts": [
    {
      "obligation_id": "RawTable.C001",
      "role": "invariant"
    },
    {
      "obligation_id": "RawTable.C004",
      "role": "caller-precondition"
    }
  ],
  "required_local_facts": [
    {
      "fact_id": "capacity_bits",
      "expression": "self.capacity_bits()"
    },
    {
      "fact_id": "capacity_mask",
      "expression": "self.capacity_mask()"
    }
  ],
  "target_expression": "ProbeSeq::from_capacity_and_h1(self.capacity_mask(), h1).offset()",
  "protocol_class": "pairwise",
  "bridge_logic": {
    "bindings": {
      "self": "RawTable",
      "h1": "u64",
      "capacity_mask": "usize",
      "capacity_bits": "usize"
    },
    "premises": [
      "capacity_mask + 1 == (1usize << capacity_bits)",
      "capacity_bits >= 4",
      "self.capacity() == capacity_mask + 1"
    ],
    "conclusion": {
      "obligation_id": "ProbeSeq.C001"
    }
  }
}
