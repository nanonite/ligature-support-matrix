{
  "schema_version": "1.0",
  "concept": "HashMix",
  "kind": "struct",
  "cluster": "hashing",
  "english_description": "A 64-bit user hash value split into the probe offset and the seven-bit control-byte tag that identify one slot.",
  "verifier": "verus",
  "queries": [
    {
      "english": "give the probe start offset",
      "rust_sig": "fn h1(&self) -> u64",
      "pure": true,
      "witness_required": false
    },
    {
      "english": "give the seven-bit control byte tag",
      "rust_sig": "fn h2(&self) -> u8",
      "pure": true,
      "witness_required": true
    }
  ],
  "commands": [
    {
      "english": "take the hash value to split",
      "rust_sig": "fn from_hash(&mut self, hash: u64)"
    }
  ],
  "constraints": [
    {
      "english": "A query is observed only after from_hash has supplied a hash.",
      "logic": "self.supplied",
      "kind": "precondition",
      "source": "hand",
      "applies_to": [
        "h1",
        "h2"
      ],
      "id": "C001"
    },
    {
      "english": "h1 is the supplied hash unchanged.",
      "logic": "self.hash == self.supplied_hash",
      "kind": "postcondition",
      "source": "hand",
      "applies_to": [
        "h1"
      ],
      "id": "C002"
    },
    {
      "english": "h2 is the seven most significant bits of the supplied hash.",
      "logic": "self.h2 as u64 == self.supplied_hash >> 57",
      "kind": "postcondition",
      "source": "hand",
      "applies_to": [
        "h2"
      ],
      "id": "C003"
    },
    {
      "english": "No query observes any field other than the supplied hash.",
      "logic": "self.hash == self.supplied_hash",
      "kind": "invariant",
      "source": "hand",
      "applies_to": [
        "h1",
        "h2"
      ],
      "id": "C004"
    }
  ],
  "adversary_table": [
    {
      "scenario": "a hash whose seven most significant bits are all zero, so h2 is 0 and a full slot's control byte reads as 0",
      "violates": "C003",
      "resolution": "preserve reference behaviour: 0 is a legal h2 and a legal control byte"
    },
    {
      "scenario": "two distinct hashes that agree on the top seven bits but differ below",
      "violates": "C003",
      "resolution": "preserve reference behaviour: they collide in the group mask exactly as upstream does"
    }
  ],
  "source_references": [
    {
      "kind": "reference-implementation",
      "citation_or_path": "absl/container/internal/raw_hash_set.h",
      "notes": "H1 and H2"
    },
    {
      "kind": "reference-implementation",
      "citation_or_path": "absl/container/internal/raw_hash_set.h",
      "notes": "PerTableSeed is mixed into H1 upstream and is out of this concept"
    }
  ]
}
