{
  "schema_version": "1.0",
  "concept": "ControlBytes",
  "kind": "struct",
  "cluster": "control-bytes",
  "english_description": "The array of one control byte per slot recording empty, deleted, sentinel, or full-with-tag, and the tests and writes over it.",
  "verifier": "verus",
  "queries": [
    {
      "english": "tell whether this slot is empty",
      "rust_sig": "fn is_empty(&self, slot: usize) -> bool",
      "pure": true,
      "witness_required": false
    },
    {
      "english": "tell whether this slot is deleted",
      "rust_sig": "fn is_dead(&self, slot: usize) -> bool",
      "pure": true,
      "witness_required": false
    },
    {
      "english": "tell whether this slot is full",
      "rust_sig": "fn is_full(&self, slot: usize) -> bool",
      "pure": true,
      "witness_required": false
    },
    {
      "english": "tell whether this slot is empty or deleted",
      "rust_sig": "fn is_empty_or_deleted(&self, slot: usize) -> bool",
      "pure": true,
      "witness_required": false
    },
    {
      "english": "count the empty slots in this group",
      "rust_sig": "fn count_empty(&self, base: usize) -> usize",
      "pure": true,
      "witness_required": true
    }
  ],
  "commands": [
    {
      "english": "mark the slot full with its tag",
      "rust_sig": "fn set_full(&mut self, slot: usize, h2: u8)"
    },
    {
      "english": "mark the slot deleted",
      "rust_sig": "fn set_dead(&mut self, slot: usize)"
    },
    {
      "english": "mark the slot empty",
      "rust_sig": "fn set_empty(&mut self, slot: usize)"
    },
    {
      "english": "reclaim every deleted slot as empty and every full slot as deleted",
      "rust_sig": "fn clear_dead(&mut self)"
    }
  ],
  "constraints": [
    {
      "english": "Every control byte holds one of empty, deleted, the sentinel, or a full byte whose low seven bits are its slot tag.",
      "logic": "self.byte(slot) == EMPTY || self.byte(slot) == DELETED || self.byte(slot) == SENTINEL || self.byte(slot) >= 0",
      "kind": "invariant",
      "source": "hand",
      "applies_to": [
        "is_empty",
        "is_dead",
        "is_full",
        "is_empty_or_deleted"
      ],
      "id": "C001"
    },
    {
      "english": "The byte at index capacity is the sentinel and no slot index equals capacity.",
      "logic": "self.capacity < self.byte_len && self.byte(self.capacity) == SENTINEL",
      "kind": "invariant",
      "source": "hand",
      "applies_to": [
        "is_empty_or_deleted"
      ],
      "id": "C002"
    },
    {
      "english": "A slot is marked deleted only while it is currently full.",
      "logic": "self.is_full(slot)",
      "kind": "precondition",
      "source": "hand",
      "applies_to": [
        "set_dead"
      ],
      "id": "C003"
    },
    {
      "english": "After a slot is marked deleted it reads as empty or deleted and every other slot is unchanged.",
      "logic": "self.is_empty_or_deleted(slot) && self.bytes_unchanged_except(slot)",
      "kind": "postcondition",
      "source": "hand",
      "applies_to": [
        "set_dead"
      ],
      "id": "C004"
    },
    {
      "english": "Reclaiming deleted slots runs over a control array that ends in the sentinel.",
      "logic": "self.byte(self.capacity) == SENTINEL",
      "kind": "precondition",
      "source": "hand",
      "applies_to": [
        "clear_dead"
      ],
      "id": "C005"
    },
    {
      "english": "Reclaiming deleted slots turns every full byte into a deleted byte, keeps every empty byte empty, and never turns a deleted byte into an empty one.",
      "logic": "self.all_full_are_deleted() && self.all_empty_stay_empty() && !self.any_deleted_became_empty()",
      "kind": "postcondition",
      "source": "hand",
      "applies_to": [
        "clear_dead"
      ],
      "id": "C006"
    },
    {
      "english": "The tag read back from a full slot is the tag that was written into it.",
      "logic": "self.tag(slot) == self.written_tag(slot)",
      "kind": "invariant",
      "source": "hand",
      "applies_to": [
        "is_full"
      ],
      "id": "C007"
    },
    {
      "english": "After a slot is marked empty it reads as empty and every other slot is unchanged.",
      "logic": "self.is_empty(slot) && self.bytes_unchanged_except(slot)",
      "kind": "postcondition",
      "source": "hand",
      "applies_to": [
        "set_empty"
      ],
      "id": "C008"
    }
  ],
  "adversary_table": [
    {
      "scenario": "marking a slot that is already deleted, as a double erase would",
      "violates": "C003",
      "resolution": "reject: the precondition is not established, so the call is not made"
    },
    {
      "scenario": "reclaiming deleted slots on a control array with no sentinel at index capacity",
      "violates": "C005",
      "resolution": "reject: the rehash precondition is not established"
    },
    {
      "scenario": "a slot whose tag byte is zero, which is a full slot and not an empty one",
      "violates": "C001",
      "resolution": "preserve reference behaviour: the high bit, not the value, distinguishes full from empty"
    }
  ],
  "source_references": [
    {
      "kind": "reference-implementation",
      "citation_or_path": "absl/container/internal/hashtable_control_bytes.h",
      "notes": "ctrl_t encoding and the scalar predicates"
    }
  ]
}
