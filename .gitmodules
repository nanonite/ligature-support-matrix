# The pilots stay their own git repositories (Ligature's work-package
# generation requires each pilot to be a Git repository root). Their histories
# live in this same GitHub repo as pilot/<name> branches.
[submodule "crypto-mixed"]
	path = crypto-mixed
	url = git@github.com:nanonite/ligature-support-matrix.git
	branch = pilot/crypto-mixed
[submodule "date-creusot"]
	path = date-creusot
	url = git@github.com:nanonite/ligature-support-matrix.git
	branch = pilot/date-creusot
[submodule "swisstable-verus"]
	path = swisstable-verus
	url = git@github.com:nanonite/ligature-support-matrix.git
	branch = pilot/swisstable-verus
[submodule "icl-creusot-verus"]
	path = icl-creusot-verus
	url = git@github.com:nanonite/ligature-support-matrix.git
	branch = pilot/icl-creusot-verus
[submodule "tinyxml2-creusot-kani"]
	path = tinyxml2-creusot-kani
	url = git@github.com:nanonite/ligature-support-matrix.git
	branch = pilot/tinyxml2-creusot-kani
[submodule "snappy-verus-kani"]
	path = snappy-verus-kani
	url = git@github.com:nanonite/ligature-support-matrix.git
	branch = pilot/snappy-verus-kani
[submodule "leveldb-three-verifiers"]
	path = leveldb-three-verifiers
	url = git@github.com:nanonite/ligature-support-matrix.git
	branch = pilot/leveldb-three-verifiers
